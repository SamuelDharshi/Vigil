# ═══════════════════════════════════════════════════════════════════════════════
# VIGIL Agent — Environment Configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env to git (it is in .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Network ───────────────────────────────────────────────────────────────────
# Mantle Sepolia public RPC — no API key required
MANTLE_RPC_URL=https://mantle-sepolia.drpc.org

# ─── Agent Wallet (REQUIRED) ───────────────────────────────────────────────────
# Private key of the agent's EVM wallet on Mantle Sepolia.
# Generate with: node -e "const {ethers}=require('ethers'); console.log(ethers.Wallet.createRandom().privateKey)"
# Fund with Mantle Sepolia testnet MNT from: https://faucet.sepolia.mantle.xyz
AGENT_PRIVATE_KEY=                       # 0x... NEVER COMMIT THIS

# ─── API Keys (from DoraHacks Hackathon Sponsor Portal) ────────────────────────
# Nansen Smart Money API — $7,000 in credits via hackathon
# Activate at: https://dorahacks.io → Sponsors → Nansen
NANSEN_API_KEY=

# Elfa AI Social Sentiment API — $36,000 in credits via hackathon
# Activate at: https://dorahacks.io → Sponsors → Elfa AI
# Elfa CEO Tristan Teo is a hackathon judge — this integration is critical
ELFA_API_KEY=

# web3.storage for IPFS pinning of Agent Cards + proof metadata
# Get at: https://web3.storage — free tier sufficient for hackathon
WEB3_STORAGE_KEY=

# ─── ERC-8004 Registry Addresses (HARDCODED — do not change) ─────────────────
# Deployed via CREATE2 — identical address on every EVM chain.
# Source: https://github.com/erc-8004/erc-8004-contracts
# These are already hardcoded in config.ts — listed here for reference only:
#   Identity Registry:   0x8004A818BFB912233c491871b3d84c89A494BD9e
#   Reputation Registry: 0x8004B663056A597Dffe9eCcC1965A193B7388713
#   Validation Registry: 0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# ─── Pyth Oracle (HARDCODED — do not change) ──────────────────────────────────
# Pyth is the oracle deployed on Mantle Sepolia (Chainlink is NOT there).
# Contract address and price IDs are hardcoded in config.ts.
# Pyth contract:  0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
# Hermes API:     https://hermes.pyth.network (public, no key required)

# ─── mETH Staking Contract (Mantle Sepolia) ────────────────────────────────────
# Used to calculate mETH APR from on-chain exchange rate.
# Source: https://docs.methprotocol.xyz/technical-docs/contracts
METH_STAKING_CONTRACT=                   # Fill from mETH Protocol docs

# ─── Token Addresses (Mantle Sepolia) ──────────────────────────────────────────
# mETH is pre-filled; others must be verified from official project docs
# before first run. MNT_TOKEN_ADDRESS is hardcoded in config.ts.
METH_ADDRESS=0xcDA86A272531e8640cD7F1a92c01839911B90bb0   # Mantle Sepolia mETH ERC-20
USDY_ADDRESS=                            # From: https://docs.ondo.finance/usdy/supported-chains
NVDAX_ADDRESS=                           # From: https://docs.fluxion.network/xstocks
AAPLX_ADDRESS=                           # From: https://docs.fluxion.network/xstocks
TSLAX_ADDRESS=                           # From: https://docs.fluxion.network/xstocks

# ─── VIGIL Deployed Contracts (fill after Phase 1 deploy) ─────────────────────
# Run: cd packages/contracts && npx hardhat run scripts/deploy.ts --network mantle_sepolia
VIGIL_VAULT_ADDRESS=
VIGIL_LEDGER_ADDRESS=
VERIFIER_ADDRESS=                        # Fill after Phase 3 ZK setup

# ─── Fluxion xChange (Mantle Sepolia — Atomic RFQ) ────────────────────────────
# VIGIL uses Fluxion for all xStocks atomic swaps with 0.40% slippage cap.
# Activated May 7, 2026 — verify addresses at https://docs.fluxion.network
FLUXION_XCHANGE_ADDRESS=                 # From Fluxion official docs
FLUXION_RFQ_ENDPOINT=https://api.fluxion.network/v1/rfq

# ─── Mantle Super Portal (Cross-Chain Bridge) ──────────────────────────────────
# Routes MNT from Mantle Sepolia → Solana Devnet for Byreal CLMM positions.
# Launched Jan 27, 2026 — verify at https://portal.mantle.xyz or bridge.sepolia.mantle.xyz
SUPER_PORTAL_ADDRESS=                    # From Mantle official bridge docs

# ─── Solana / Byreal Configuration ────────────────────────────────────────────
# Byreal CLMM for MNT-USDC yield positions on Solana Devnet.
# Prerequisite: npm install -g @byreal-io/byreal-cli
#               byreal-cli init --home ~/.config/byreal/vigil-agent
BYREAL_SOLANA_WALLET=                    # Path to Solana keypair JSON

# ─── Database & Services ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:vigil@localhost:5432/vigil
WS_PORT=8080

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_MANTLE_EXPLORER=https://sepolia.mantlescan.xyz
